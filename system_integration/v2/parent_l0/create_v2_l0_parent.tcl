# Create a clean Zynq-7000 Stage L0 parent without modifying project_4.
# The reference PS7 parameter snapshot is generated by run_v2_l0_parent.ps1.

if {[llength $argv] != 6} {
    error {Usage: create_v2_l0_parent.tcl OUTPUT_ROOT PS_CONFIG PIN_XDC TIMING_XDC OUTPUT_WIDTH HDL_ROOT}
}
lassign $argv output_root ps_config_path pin_xdc timing_xdc output_width hdl_root
set output_root [file normalize $output_root]
set ps_config_path [file normalize $ps_config_path]
set pin_xdc [file normalize $pin_xdc]
set timing_xdc [file normalize $timing_xdc]
set hdl_root [file normalize $hdl_root]
set v2_dir [file join $hdl_root system_integration v2]
set v2_repo [file join $v2_dir ip_repo]
set profile_bridge_source [file join $v2_dir parent_l0 \
    l0_vdma_profile_bridge.vhd]

foreach required [list $ps_config_path $pin_xdc $timing_xdc \
        $profile_bridge_source \
        [file join $v2_repo tdc_gpx_lidar_ctrl_v2_2_0 component.xml]] {
    if {![file exists $required]} {
        error "Required L0 input is missing: $required"
    }
}
if {$output_width ni {32 64 128}} {
    error "Unsupported L0 AXIS width: $output_width"
}
if {[file exists $output_root]} {
    error "Output root must not exist: $output_root"
}

# Avoid the damaged per-user Tcl Store on this workstation.
set install_tcl_store [file normalize \
    [file join $::env(XILINX_VIVADO) data XilinxTclStore]]
lappend auto_path [file join $install_tcl_store support appinit]
foreach vendor_dir [glob -nocomplain -type d \
        [file join $install_tcl_store tclapp *]] {
    foreach app_dir [glob -nocomplain -type d [file join $vendor_dir *]] {
        lappend auto_path $app_dir
    }
}
package require ::tclapp::support::appinit 1.2

source $ps_config_path
if {![info exists l0_ps_config] || ![info exists l0_reference_ps_parameter_count]} {
    error {Generated PS7 configuration did not define its contract variables}
}

file mkdir $output_root
create_project project_4_lidar_v2_l0 $output_root \
    -part xc7z020clg484-2 -force
set_property target_language VHDL [current_project]
set_property simulator_language Mixed [current_project]
set_property ip_repo_paths [list $v2_repo] [current_project]
update_ip_catalog -rebuild
add_files -norecurse $profile_bridge_source
# Vivado module references do not accept a VHDL-2008 top. This bridge uses
# only VHDL-2002 syntax; keep its file type compatible with Block Design.
set_property FILE_TYPE {VHDL} [get_files $profile_bridge_source]
update_compile_order -fileset sources_1

set v2_vlnv victek.co.kr:my_ip:tdc_gpx_lidar_ctrl_v2:2.0
if {[llength [get_ipdefs -all $v2_vlnv]] != 1} {
    error "Expected one v2 IP definition: $v2_vlnv"
}

create_bd_design design_1_lidar_ctrl_v2

set ps7 [create_bd_cell -type ip \
    -vlnv xilinx.com:ip:processing_system7:5.5 processing_system7_0]
set_property -dict $l0_ps_config $ps7
set_property -dict [list \
    CONFIG.PCW_FPGA_FCLK0_ENABLE 1 \
    CONFIG.PCW_FPGA_FCLK1_ENABLE 1 \
    CONFIG.PCW_FPGA_FCLK2_ENABLE 1 \
    CONFIG.PCW_FPGA0_PERIPHERAL_FREQMHZ 100 \
    CONFIG.PCW_FPGA1_PERIPHERAL_FREQMHZ 100 \
    CONFIG.PCW_FPGA2_PERIPHERAL_FREQMHZ 200 \
    CONFIG.PCW_USE_M_AXI_GP0 1 \
    CONFIG.PCW_USE_S_AXI_HP0 1 \
    CONFIG.PCW_USE_S_AXI_HP1 1 \
    CONFIG.PCW_S_AXI_HP0_DATA_WIDTH 64 \
    CONFIG.PCW_S_AXI_HP1_DATA_WIDTH 64 \
    CONFIG.PCW_IRQ_F2P_INTR 1] $ps7

set lidar [create_bd_cell -type ip -vlnv $v2_vlnv tdc_gpx_lidar_ctrl_v2_0]
set_property -dict [list \
    CONFIG.G_CSR_CLK_MHZ 100 \
    CONFIG.G_PROC_CLK_MHZ 150 \
    CONFIG.G_TDC_CLK_MHZ 200 \
    CONFIG.G_STREAM_CLK_MODE ASYNC \
    CONFIG.G_NUM_CHIPS 2 \
    CONFIG.G_STOPS_PER_CHIP 8 \
    CONFIG.G_MAX_RETURNS_PER_STOP 7 \
    CONFIG.G_RISE_CAPABILITY_MASK 0011 \
    CONFIG.G_FALL_CAPABILITY_MASK 0000 \
    CONFIG.G_OUTPUT_WIDTH $output_width \
    CONFIG.G_NUM_FACES 5 \
    CONFIG.G_ENABLE_ECHO_RECEIVER false \
    CONFIG.G_ENABLE_ECHO_SIMULATION false \
    CONFIG.G_OEN_MODE PULLUP_OR_NOT_CONNECTED] $lidar

# The v2 core produces its VDMA profile in the 150 MHz Processing domain,
# while PS reads and acknowledges it through 100 MHz AXI GPIO. One XPM
# bundled-data handshake per slope makes the 49-bit profile atomic and returns
# ACK to the original domain without a direct asynchronous control path.
set rise_profile_bridge [create_bd_cell -type module \
    -reference l0_vdma_profile_bridge rise_profile_bridge]
set fall_profile_bridge [create_bd_cell -type module \
    -reference l0_vdma_profile_bridge fall_profile_bridge]

proc l0_create_s2mm_vdma {name} {
    set cell [create_bd_cell -type ip \
        -vlnv xilinx.com:ip:axi_vdma:6.3 $name]
    set_property -dict [list \
        CONFIG.c_include_mm2s 0 \
        CONFIG.c_include_s2mm 1 \
        CONFIG.c_include_sg 0 \
        CONFIG.c_num_fstores 3 \
        CONFIG.c_m_axi_s2mm_data_width 64 \
        CONFIG.c_include_s2mm_sf 1 \
        CONFIG.c_s2mm_linebuffer_depth 512 \
        CONFIG.c_s2mm_max_burst_length 16 \
        CONFIG.c_s2mm_sof_enable 1 \
        CONFIG.c_use_s2mm_fsync 0] $cell
    return $cell
}

set rise_vdma [l0_create_s2mm_vdma axi_vdma_rise]
set fall_vdma [l0_create_s2mm_vdma axi_vdma_fall]

# The Zynq-7000 PS PLL cannot synthesize an exact 150 MHz FCLK for this board
# profile. Reuse the board-proven 100 MHz FCLK -> 150 MHz MMCM contract.
set proc_clk_wiz [create_bd_cell -type ip \
    -vlnv xilinx.com:ip:clk_wiz:6.0 proc_clk_wiz]
set_property -dict [list \
    CONFIG.PRIM_SOURCE No_buffer \
    CONFIG.PRIM_IN_FREQ 100.000 \
    CONFIG.CLKOUT1_REQUESTED_OUT_FREQ 150.000 \
    CONFIG.USE_LOCKED true \
    CONFIG.USE_RESET false] $proc_clk_wiz

proc l0_create_hp_protocol_converter {name} {
    set cell [create_bd_cell -type ip \
        -vlnv xilinx.com:ip:axi_protocol_converter:2.1 $name]
    set_property -dict [list \
        CONFIG.SI_PROTOCOL AXI4 \
        CONFIG.MI_PROTOCOL AXI3 \
        CONFIG.DATA_WIDTH 64] $cell
    return $cell
}

# Zynq-7000 HP ports are AXI3 while AXI VDMA exposes an AXI4 memory master.
# Keep one converter per slope so Rise/Fall DDR traffic stays independent.
set rise_hp_converter [l0_create_hp_protocol_converter rise_hp_axi4_to_axi3]
set fall_hp_converter [l0_create_hp_protocol_converter fall_hp_axi4_to_axi3]

set axi_ctrl [create_bd_cell -type ip \
    -vlnv xilinx.com:ip:axi_interconnect:2.1 axi_control_interconnect]
set_property -dict [list CONFIG.NUM_SI 1 CONFIG.NUM_MI 6] $axi_ctrl

proc l0_create_gpio {name width1 input1 dual width2 input2} {
    set cell [create_bd_cell -type ip -vlnv xilinx.com:ip:axi_gpio:2.0 $name]
    set properties [list CONFIG.C_GPIO_WIDTH $width1 CONFIG.C_IS_DUAL $dual]
    if {$input1} {
        lappend properties CONFIG.C_ALL_INPUTS 1
    } else {
        lappend properties CONFIG.C_ALL_OUTPUTS 1
    }
    if {$dual} {
        lappend properties CONFIG.C_GPIO2_WIDTH $width2
        if {$input2} {
            lappend properties CONFIG.C_ALL_INPUTS_2 1
        } else {
            lappend properties CONFIG.C_ALL_OUTPUTS_2 1 \
                CONFIG.C_DOUT_DEFAULT_2 0x00000000
        }
    }
    set_property -dict $properties $cell
    return $cell
}

# Channel 1 reports pending valid/enable. Channel 2 lets PS pulse the two ACKs.
set profile_ctrl [l0_create_gpio vdma_profile_ctrl 4 true 1 2 false]
set rise_geometry [l0_create_gpio vdma_rise_geometry 32 true 1 16 true]
set fall_geometry [l0_create_gpio vdma_fall_geometry 32 true 1 16 true]

foreach {name ports} {
        prof_status_cat 4
        vdma_rise_geometry_concat 2
        vdma_fall_geometry_concat 2
        irq_concat 16} {
    set cell [create_bd_cell -type ip -vlnv xilinx.com:ip:xlconcat:2.1 $name]
    set_property CONFIG.NUM_PORTS $ports $cell
}
foreach {name index} {rise_cfg_ack_slice 0 fall_cfg_ack_slice 1} {
    set cell [create_bd_cell -type ip -vlnv xilinx.com:ip:xlslice:1.0 $name]
    set_property -dict [list CONFIG.DIN_WIDTH 2 CONFIG.DIN_FROM $index \
        CONFIG.DIN_TO $index CONFIG.DOUT_WIDTH 1] $cell
}

foreach {name width value} {
        const_zero_1 1 0
        const_zero_2 2 0
        const_one_1 1 1} {
    set cell [create_bd_cell -type ip -vlnv xilinx.com:ip:xlconstant:1.1 $name]
    set_property -dict [list CONFIG.CONST_WIDTH $width CONFIG.CONST_VAL $value] $cell
}

foreach name {rst_csr rst_proc rst_tdc} {
    create_bd_cell -type ip -vlnv xilinx.com:ip:proc_sys_reset:5.0 $name
}

# External board interfaces and service pins. OEN/LF/ERRFLAG remain present in
# the IP but are intentionally handled by the pull-up/inactive parent policy.
make_bd_intf_pins_external [get_bd_intf_pins $ps7/DDR]
set_property name DDR [get_bd_intf_ports DDR_0]
make_bd_intf_pins_external [get_bd_intf_pins $ps7/FIXED_IO]
set_property name FIXED_IO [get_bd_intf_ports FIXED_IO_0]

proc l0_externalize_pin {cell pin external_name} {
    make_bd_pins_external [get_bd_pins $cell/$pin]
    set generated [lindex [get_bd_ports -filter "NAME =~ ${pin}*"] end]
    set_property name $external_name $generated
}
foreach pin {
        i_enc_a i_enc_b i_enc_z i_fire_done
        i_tdc_ef1 i_tdc_ef2 i_tdc_irflag
        io_tdc_d o_tdc_adr o_tdc_csn o_tdc_rdn o_tdc_wrn
        o_tdc_stopdis o_tdc_alutrigger o_tdc_puresn
        o_fire_pulse o_start_tdc o_stop_tdc} {
    l0_externalize_pin $lidar $pin $pin
}

# Clock/reset contract: FCLK0=CSR 100 MHz, FCLK1=Processing 150 MHz,
# FCLK2=TDC bus/acquisition 200 MHz. These are separate physical clocks.
connect_bd_net [get_bd_pins $ps7/FCLK_CLK0] \
    [get_bd_pins $ps7/M_AXI_GP0_ACLK] \
    [get_bd_pins $lidar/s_axi_csr_aclk] \
    [get_bd_pins $axi_ctrl/ACLK] [get_bd_pins $axi_ctrl/S00_ACLK]
for {set i 0} {$i < 6} {incr i} {
    connect_bd_net [get_bd_pins $ps7/FCLK_CLK0] \
        [get_bd_pins [format "$axi_ctrl/M%02d_ACLK" $i]]
}
connect_bd_net [get_bd_pins $ps7/FCLK_CLK1] \
    [get_bd_pins $proc_clk_wiz/clk_in1]
foreach cell [list $rise_vdma $fall_vdma] {
    connect_bd_net [get_bd_pins $ps7/FCLK_CLK0] \
        [get_bd_pins $cell/s_axi_lite_aclk]
    connect_bd_net [get_bd_pins $proc_clk_wiz/clk_out1] \
        [get_bd_pins $cell/m_axi_s2mm_aclk] \
        [get_bd_pins $cell/s_axis_s2mm_aclk]
}
foreach cell [list $rise_hp_converter $fall_hp_converter] {
    connect_bd_net [get_bd_pins $proc_clk_wiz/clk_out1] \
        [get_bd_pins $cell/aclk]
}
foreach cell [list $profile_ctrl $rise_geometry $fall_geometry] {
    connect_bd_net [get_bd_pins $ps7/FCLK_CLK0] [get_bd_pins $cell/s_axi_aclk]
}
foreach bridge [list $rise_profile_bridge $fall_profile_bridge] {
    connect_bd_net [get_bd_pins $ps7/FCLK_CLK0] \
        [get_bd_pins $bridge/i_csr_clk]
}
connect_bd_net [get_bd_pins $proc_clk_wiz/clk_out1] \
    [get_bd_pins $lidar/proc_aclk] \
    [get_bd_pins $ps7/S_AXI_HP0_ACLK] \
    [get_bd_pins $ps7/S_AXI_HP1_ACLK]
foreach bridge [list $rise_profile_bridge $fall_profile_bridge] {
    connect_bd_net [get_bd_pins $proc_clk_wiz/clk_out1] \
        [get_bd_pins $bridge/i_proc_clk]
}
connect_bd_net [get_bd_pins $ps7/FCLK_CLK2] [get_bd_pins $lidar/i_tdc_clk]

connect_bd_net [get_bd_pins $ps7/FCLK_RESET0_N] \
    [get_bd_pins rst_csr/ext_reset_in] \
    [get_bd_pins rst_proc/ext_reset_in] \
    [get_bd_pins rst_tdc/ext_reset_in]
connect_bd_net [get_bd_pins $ps7/FCLK_CLK0] [get_bd_pins rst_csr/slowest_sync_clk]
connect_bd_net [get_bd_pins $proc_clk_wiz/clk_out1] \
    [get_bd_pins rst_proc/slowest_sync_clk]
connect_bd_net [get_bd_pins $proc_clk_wiz/locked] \
    [get_bd_pins rst_proc/dcm_locked]
connect_bd_net [get_bd_pins $ps7/FCLK_CLK2] [get_bd_pins rst_tdc/slowest_sync_clk]

connect_bd_net [get_bd_pins rst_csr/peripheral_aresetn] \
    [get_bd_pins $lidar/s_axi_csr_aresetn] \
    [get_bd_pins $rise_vdma/axi_resetn] \
    [get_bd_pins $fall_vdma/axi_resetn]
connect_bd_net [get_bd_pins rst_csr/interconnect_aresetn] \
    [get_bd_pins $axi_ctrl/ARESETN] [get_bd_pins $axi_ctrl/S00_ARESETN]
for {set i 0} {$i < 6} {incr i} {
    connect_bd_net [get_bd_pins rst_csr/peripheral_aresetn] \
        [get_bd_pins [format "$axi_ctrl/M%02d_ARESETN" $i]]
}
foreach cell [list $profile_ctrl $rise_geometry $fall_geometry] {
    connect_bd_net [get_bd_pins rst_csr/peripheral_aresetn] \
        [get_bd_pins $cell/s_axi_aresetn]
}
foreach bridge [list $rise_profile_bridge $fall_profile_bridge] {
    connect_bd_net [get_bd_pins rst_csr/peripheral_aresetn] \
        [get_bd_pins $bridge/i_csr_rst_n]
}
connect_bd_net [get_bd_pins rst_proc/peripheral_aresetn] \
    [get_bd_pins $lidar/proc_aresetn] \
    [get_bd_pins $rise_hp_converter/aresetn] \
    [get_bd_pins $fall_hp_converter/aresetn]
foreach bridge [list $rise_profile_bridge $fall_profile_bridge] {
    connect_bd_net [get_bd_pins rst_proc/peripheral_aresetn] \
        [get_bd_pins $bridge/i_proc_rst_n]
}
connect_bd_net [get_bd_pins rst_tdc/peripheral_aresetn] \
    [get_bd_pins $lidar/i_tdc_aresetn]

# AXI-Lite control path and independent HP-port write channels.
connect_bd_intf_net [get_bd_intf_pins $ps7/M_AXI_GP0] \
    [get_bd_intf_pins $axi_ctrl/S00_AXI]
foreach {index endpoint} [list \
        0 $lidar/s_axi_csr \
        1 $rise_vdma/S_AXI_LITE \
        2 $fall_vdma/S_AXI_LITE \
        3 $profile_ctrl/S_AXI \
        4 $rise_geometry/S_AXI \
        5 $fall_geometry/S_AXI] {
    connect_bd_intf_net [get_bd_intf_pins [format "$axi_ctrl/M%02d_AXI" $index]] \
        [get_bd_intf_pins $endpoint]
}
connect_bd_intf_net [get_bd_intf_pins $rise_vdma/M_AXI_S2MM] \
    [get_bd_intf_pins $rise_hp_converter/S_AXI]
connect_bd_intf_net [get_bd_intf_pins $rise_hp_converter/M_AXI] \
    [get_bd_intf_pins $ps7/S_AXI_HP0]
connect_bd_intf_net [get_bd_intf_pins $fall_vdma/M_AXI_S2MM] \
    [get_bd_intf_pins $fall_hp_converter/S_AXI]
connect_bd_intf_net [get_bd_intf_pins $fall_hp_converter/M_AXI] \
    [get_bd_intf_pins $ps7/S_AXI_HP1]
connect_bd_intf_net [get_bd_intf_pins $lidar/m_axis_rise] \
    [get_bd_intf_pins $rise_vdma/S_AXIS_S2MM]
connect_bd_intf_net [get_bd_intf_pins $lidar/m_axis_fall] \
    [get_bd_intf_pins $fall_vdma/S_AXIS_S2MM]

# Pending profile contract visible to PS. Every profile crosses as one atomic
# tuple. ACK is accepted only after the corresponding VDMA registers are
# programmed and then returns through the same handshake.
foreach {prefix bridge} [list \
        rise $rise_profile_bridge fall $fall_profile_bridge] {
    connect_bd_net [get_bd_pins $lidar/o_vdma_${prefix}_cfg_valid] \
        [get_bd_pins $bridge/i_proc_cfg_valid]
    connect_bd_net [get_bd_pins $lidar/o_vdma_${prefix}_cfg_enable] \
        [get_bd_pins $bridge/i_proc_cfg_enable]
    connect_bd_net [get_bd_pins $lidar/o_vdma_${prefix}_hsize_bytes] \
        [get_bd_pins $bridge/i_proc_hsize_bytes]
    connect_bd_net [get_bd_pins $lidar/o_vdma_${prefix}_vsize_lines] \
        [get_bd_pins $bridge/i_proc_vsize_lines]
    connect_bd_net [get_bd_pins $lidar/o_vdma_${prefix}_stride_bytes] \
        [get_bd_pins $bridge/i_proc_stride_bytes]
    connect_bd_net [get_bd_pins $bridge/o_proc_cfg_ready] \
        [get_bd_pins $lidar/i_vdma_${prefix}_cfg_ready]
}
connect_bd_net [get_bd_pins $rise_profile_bridge/o_csr_cfg_valid] \
    [get_bd_pins prof_status_cat/In0]
connect_bd_net [get_bd_pins $rise_profile_bridge/o_csr_cfg_enable] \
    [get_bd_pins prof_status_cat/In1]
connect_bd_net [get_bd_pins $fall_profile_bridge/o_csr_cfg_valid] \
    [get_bd_pins prof_status_cat/In2]
connect_bd_net [get_bd_pins $fall_profile_bridge/o_csr_cfg_enable] \
    [get_bd_pins prof_status_cat/In3]
connect_bd_net [get_bd_pins prof_status_cat/dout] \
    [get_bd_pins $profile_ctrl/gpio_io_i]
connect_bd_net [get_bd_pins $profile_ctrl/gpio2_io_o] \
    [get_bd_pins rise_cfg_ack_slice/Din] [get_bd_pins fall_cfg_ack_slice/Din]
connect_bd_net [get_bd_pins rise_cfg_ack_slice/Dout] \
    [get_bd_pins $rise_profile_bridge/i_csr_cfg_ack]
connect_bd_net [get_bd_pins fall_cfg_ack_slice/Dout] \
    [get_bd_pins $fall_profile_bridge/i_csr_cfg_ack]

foreach {prefix bridge geometry} [list \
        rise $rise_profile_bridge vdma_rise_geometry \
        fall $fall_profile_bridge vdma_fall_geometry] {
    connect_bd_net [get_bd_pins $bridge/o_csr_hsize_bytes] \
        [get_bd_pins vdma_${prefix}_geometry_concat/In0]
    connect_bd_net [get_bd_pins $bridge/o_csr_vsize_lines] \
        [get_bd_pins vdma_${prefix}_geometry_concat/In1]
    connect_bd_net [get_bd_pins vdma_${prefix}_geometry_concat/dout] \
        [get_bd_pins $geometry/gpio_io_i]
    connect_bd_net [get_bd_pins $bridge/o_csr_stride_bytes] \
        [get_bd_pins $geometry/gpio2_io_i]
}

# L0 safety and optional-pin policy.
connect_bd_net [get_bd_pins const_zero_1/dout] \
    [get_bd_pins $lidar/i_external_laser_permit]
connect_bd_net [get_bd_pins const_zero_2/dout] \
    [get_bd_pins $lidar/i_tdc_lf1] [get_bd_pins $lidar/i_tdc_lf2] \
    [get_bd_pins $lidar/i_tdc_errflag]
connect_bd_net [get_bd_pins const_one_1/dout] \
    [get_bd_pins $lidar/m_axis_monitor_tready]

# Three independent interrupt bits: integrated controller, Rise VDMA, Fall VDMA.
connect_bd_net [get_bd_pins $lidar/o_irq] [get_bd_pins irq_concat/In0]
connect_bd_net [get_bd_pins $rise_vdma/s2mm_introut] [get_bd_pins irq_concat/In1]
connect_bd_net [get_bd_pins $fall_vdma/s2mm_introut] [get_bd_pins irq_concat/In2]
for {set i 3} {$i < 16} {incr i} {
    connect_bd_net [get_bd_pins const_zero_1/dout] \
        [get_bd_pins [format "irq_concat/In%d" $i]]
}
connect_bd_net [get_bd_pins irq_concat/dout] [get_bd_pins $ps7/IRQ_F2P]

assign_bd_address
validate_bd_design
save_bd_design

set bd_file [get_files design_1_lidar_ctrl_v2.bd]
generate_target all $bd_file
set wrapper [make_wrapper -files $bd_file -top]
add_files -norecurse $wrapper
set_property top design_1_lidar_ctrl_v2_wrapper [current_fileset]

set constraints_dir [file join $output_root constraints]
file mkdir $constraints_dir
set copied_pin_xdc [file join $constraints_dir project4_vt_hrl2_tdc01_service.xdc]
file copy -force $pin_xdc $copied_pin_xdc
add_files -fileset constrs_1 -norecurse $copied_pin_xdc
set copied_timing_xdc [file join $constraints_dir l0_parent_timing.xdc]
file copy -force $timing_xdc $copied_timing_xdc
add_files -fileset constrs_1 -norecurse $copied_timing_xdc

set reports_dir [file join $output_root reports]
file mkdir $reports_dir
set report_path [file join $reports_dir l0_bd_contract.txt]
set channel [open $report_path w]
puts $channel "project=project_4_lidar_v2_l0"
puts $channel "design=design_1_lidar_ctrl_v2"
puts $channel "part=xc7z020clg484-2"
puts $channel "v2_vlnv=$v2_vlnv"
puts $channel "reference_ps_parameters=$l0_reference_ps_parameter_count"
puts $channel "clocks_mhz=csr_fclk0:100,processing_fclk1_mmcm:100_to_150,tdc_bus_fclk2:200"
puts $channel "output_width_bits=$output_width"
puts $channel {build=2 chips,8 STOP/chip,7 max Returns,rise 0011,fall 0000}
puts $channel {echo_receiver=false,echo_simulation=false,external_laser_permit=0}
puts $channel {memory=Rise S2MM->HP0,Fall S2MM->HP1,64-bit HP,triple buffers}
puts $channel {irq_f2p[0]=controller,irq_f2p[1]=rise_vdma,irq_f2p[2]=fall_vdma}
puts $channel {vdma_profile_ack=PS GPIO pulse after programming pending geometry}
puts $channel {vdma_profile_cdc=49-bit XPM handshake per slope,stale-high ACK rejected}
puts $channel {memory_protocol=VDMA AXI4 -> explicit 64-bit AXI4-to-AXI3 converter -> PS7 HP}
close $channel

puts "LIDAR_V2_L0_PARENT_CREATE_PASS output=$output_root width=$output_width"
close_project
exit 0
